{
  "FileVersion": 3,
  "Version": 2,
  "VersionName": "0.2.0",
  "FriendlyName": "Catalyst:Landform",
  "Description": "Deterministic procedural planets and the Planet editor, presented through Voxel Plugin.",
  "Category": "BenjaVision",
  "CreatedBy": "BenjaVision",
  "CanContainContent": true,
  "IsExperimentalVersion": true,
  "Installed": false,
  "Plugins": [
    {
      "Name": "CatalystFoundation",
      "Enabled": true
    },
    {
      "Name": "Voxel",
      "Enabled": true
    },
    {
      "Name": "ProceduralMeshComponent",
      "Enabled": true
    },
    {
      "Name": "PCG",
      "Enabled": true
    },
    {
      "Name": "GeoReferencing",
      "Enabled": true
    }
  ],
  "Modules": [
    {
      "Name": "CatalystLandformRender",
      "Type": "Runtime",
      "LoadingPhase": "PostConfigInit"
    },
    {
      "Name": "CatalystLandform",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    },
    {
      "Name": "CatalystLandformEditor",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit"
    },
    {
      "Name": "CatalystLandformTests",
      "Type": "Editor",
      "LoadingPhase": "None"
    }
  ],
  "PreBuildSteps": {
    "Mac": [
      "python3 \"$(PluginDir)/Tools/build-spatial-ispc.py\""
    ]
  }
}
