#ifndef CL_NANITE_PROJECTION_USH
#define CL_NANITE_PROJECTION_USH
#include "/Plugin/CatalystLandform/Public/CLProjectionPosition.ush"
#include "/Plugin/CatalystLandform/Public/CLAnchoredScene.ush"

bool CLHasProjection(FPrimitiveSceneData P)
{
    return P.CustomPrimitiveData[2].w == 9137.0f || P.CustomPrimitiveData[2].w == 9140.0f || P.CustomPrimitiveData[2].w == 9150.0f;
}
FCLProjectionFrame CLNaniteFrame(float4 Data)
{
    FCLProjectionFrame F;
    F.Anchor = normalize(Data.xyz);
    F.Curvature = Data.w;
    F.MaxArc = 1.0471975512f;
    F.MinAltitude = -.4f;
    F.MaxAltitude = .3f;
    return F;
}
// Project the same base vertices used by the material WPO before tessellation
// patch bounds and edge factors are evaluated. Coordinates remain instance-local.
float3 CLNaniteProjectLocalPosition(FPrimitiveSceneData P,FInstanceSceneData I,float3 Local,bool Previous)
{
    const float4 Frame=Previous?P.CustomPrimitiveData[1]:P.CustomPrimitiveData[0];
    if(!CLHasProjection(P) || Frame.w==1) return Local;
    const float4 Packet=P.CustomPrimitiveData[2];
    const float4x4 L2W=DFHackToFloat(I.LocalToWorld),W2L=DFHackToFloat(I.WorldToLocal);
    const float3 World=mul(float4(Local,1),L2W).xyz;
    float3 Target;
    if(Packet.w==9150)
    {
        const float3 Origin=Previous?P.CustomPrimitiveData[5].xyz+P.CustomPrimitiveData[6].xyz:P.CustomPrimitiveData[3].xyz+P.CustomPrimitiveData[4].xyz;
        Target=CLAnchoredPosition(Packet.x,normalize(Frame.xyz),Frame.w,World-Origin)+Origin;
    }
    else if(Packet.w==9140)
    {
        const float3 Root=DFDemote(P.ActorWorldPosition),Origin=Previous?P.CustomPrimitiveData[4].xyz:P.CustomPrimitiveData[3].xyz;
        Target=CLAnchoredPosition(Packet.x,normalize(Frame.xyz),Frame.w,World-Root-Origin)+Origin+Root;
    }
    else Target=CLProjectionPosition(CLNaniteFrame(Frame),World/Packet.x)*Packet.x;
    return mul(float4(Target,1),W2L).xyz;
}
void CLNaniteProjectBox(FPrimitiveSceneData P, FInstanceSceneData I, inout float3 Center, inout float3 Extent)
{
    if (!CLHasProjection(P) || (P.CustomPrimitiveData[0].w == 1 && P.CustomPrimitiveData[1].w == 1)) return;
    const float4 Packet = P.CustomPrimitiveData[2];
    // Prototype contract: planet at world origin, uniformly scaled static VPP instances.
    const float4x4 L2W = DFHackToFloat(I.LocalToWorld);
    const float4x4 W2L = DFHackToFloat(I.WorldToLocal);
    if(Packet.w==9150)
    {
        const float3 Origin=P.CustomPrimitiveData[3].xyz+P.CustomPrimitiveData[4].xyz;
        const float3 OldOrigin=P.CustomPrimitiveData[5].xyz+P.CustomPrimitiveData[6].xyz;
        const float3 World=mul(float4(Center,1),L2W).xyz;
        // A nonlinear rotation can move any source axis into any target axis.
        const float3 E=(length(mul(Extent,abs((float3x3)L2W)))*Packet.y+Packet.x*2.e-6f).xxx;
        const float3 C0=CLAnchoredPosition(Packet.x,normalize(P.CustomPrimitiveData[0].xyz),P.CustomPrimitiveData[0].w,World-Origin)+Origin;
        const float3 C1=CLAnchoredPosition(Packet.x,normalize(P.CustomPrimitiveData[1].xyz),P.CustomPrimitiveData[1].w,World-OldOrigin)+OldOrigin;
        const float3 Low=min(C0,C1)-E,High=max(C0,C1)+E;
        Center=mul(float4((Low+High)*.5,1),W2L).xyz;Extent=mul((High-Low)*.5,abs((float3x3)W2L));return;
    }
    if(Packet.w==9140)
    {
        const float3 Root=DFDemote(P.ActorWorldPosition);
        const float3 Source=mul(float4(Center,1),L2W).xyz-Root;
        // A nonlinear rotation can move any source axis into any target axis.
        const float3 E=(length(mul(Extent,abs((float3x3)L2W)))*Packet.y+Packet.x*2.e-6f).xxx;
        float3 C0=CLAnchoredPosition(Packet.x,normalize(P.CustomPrimitiveData[0].xyz),P.CustomPrimitiveData[0].w,Source-P.CustomPrimitiveData[3].xyz)+P.CustomPrimitiveData[3].xyz;
        float3 C1=CLAnchoredPosition(Packet.x,normalize(P.CustomPrimitiveData[1].xyz),P.CustomPrimitiveData[1].w,Source-P.CustomPrimitiveData[4].xyz)+P.CustomPrimitiveData[4].xyz;
        const float3 Low=min(C0,C1)-E,High=max(C0,C1)+E;
        Center=mul(float4((Low+High)*.5+Root,1),W2L).xyz;Extent=mul((High-Low)*.5,abs((float3x3)W2L));return;
    }
    float3 SourceCenter = Center, SourceExtent = Extent;
    if (Packet.z == 2) { SourceCenter = P.CustomPrimitiveData[3].xyz; SourceExtent = P.CustomPrimitiveData[4].xyz; }
    float3 C = mul(float4(SourceCenter, 1), L2W).xyz / Packet.x;
    float3 E = mul(SourceExtent, abs((float3x3)L2W)) / Packet.x;
    float3 C0, E0, C1, E1;
    CLProjectionUnitBox(CLNaniteFrame(P.CustomPrimitiveData[0]), C, E, Packet.y, C0, E0);
    CLProjectionUnitBox(CLNaniteFrame(P.CustomPrimitiveData[1]), C, E, Packet.y, C1, E1);
    float3 BMin = min(C0 - E0, C1 - E1) * Packet.x;
    float3 BMax = max(C0 + E0, C1 + E1) * Packet.x;
    Center = mul(float4((BMin + BMax) * .5f, 1), W2L).xyz;
    Extent = mul((BMax - BMin) * .5f, abs((float3x3)W2L));
}
void CLNaniteProjectNode(FPrimitiveSceneData P, FInstanceSceneData I, inout FNodeCullingBounds B)
{
    if (!CLHasProjection(P) || (P.CustomPrimitiveData[0].w == 1 && P.CustomPrimitiveData[1].w == 1)) return;
    CLNaniteProjectBox(P, I, B.BoxCenter, B.BoxExtent);
    const float4 Packet = P.CustomPrimitiveData[2];
    const float4x4 L2W = DFHackToFloat(I.LocalToWorld);
    const float4x4 W2L = DFHackToFloat(I.WorldToLocal);
    if(Packet.w==9150)
    {
        const float3 Origin=P.CustomPrimitiveData[3].xyz+P.CustomPrimitiveData[4].xyz;
        const float3 Source=mul(float4(B.Sphere.xyz,1),L2W).xyz;
        const float3 Target=CLAnchoredPosition(Packet.x,normalize(P.CustomPrimitiveData[0].xyz),P.CustomPrimitiveData[0].w,Source-Origin)+Origin;
        B.Sphere.xyz=mul(float4(Target,1),W2L).xyz;B.Sphere.w*=Packet.y;B.MeshMinDeformScale*=Packet.y;B.NodeMaxDeformScale*=Packet.y;return;
    }
    if(Packet.w==9140)
    {
        const float3 Root=DFDemote(P.ActorWorldPosition),Origin=P.CustomPrimitiveData[3].xyz;
        float3 Source=mul(float4(B.Sphere.xyz,1),L2W).xyz-Root;
        float3 Target=CLAnchoredPosition(Packet.x,normalize(P.CustomPrimitiveData[0].xyz),P.CustomPrimitiveData[0].w,Source-Origin)+Origin+Root;
        B.Sphere.xyz=mul(float4(Target,1),W2L).xyz;B.Sphere.w*=Packet.y;B.MeshMinDeformScale*=Packet.y;B.NodeMaxDeformScale*=Packet.y;return;
    }
    float3 Source = mul(float4(B.Sphere.xyz, 1), L2W).xyz / Packet.x;
    float3 Presented = CLProjectionPosition(CLNaniteFrame(P.CustomPrimitiveData[0]), Source) * Packet.x;
    B.Sphere.xyz = mul(float4(Presented, 1), W2L).xyz;
    B.Sphere.w *= Packet.y;
    // Keep this identical throughout the primitive's hierarchy to preserve the LOD cut.
    B.MeshMinDeformScale *= Packet.y;
    B.NodeMaxDeformScale *= Packet.y;
}
#endif
